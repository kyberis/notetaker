### Core ###
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/will?schema=public"
# Used by `prisma db push` in CI/local; defaults to DATABASE_URL when unset.
# Prefer the unpooled (direct) URL here if your provider distinguishes them
# (e.g. Neon / Supabase) so DDL doesn't go through PgBouncer.
# DATABASE_URL_UNPOOLED=
# Optional shadow DB for `prisma migrate diff` (drift detection in CI).
# SHADOW_DATABASE_URL=

# Neon / managed Postgres on Vercel: add sslmode=verify-full (or your provider's
# recommendation) to silence the node-pg SSL deprecation warning in logs.
NEXTAUTH_URL="http://localhost:3200"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Comma-separated allow-list of emails that get promoted to admin on sign-in.
# Idempotent: only flips `isAdmin` from false to true. Demote requires a
# manual `UPDATE "User" SET "isAdmin"=false …`.
ADMIN_EMAILS=""

### Google OAuth (optional) ###
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

### AI (Vercel AI Gateway, recommended) ###
# Run `vercel link` once and `vercel env pull .env.local` periodically; this
# provisions VERCEL_OIDC_TOKEN automatically and is the preferred auth path.
# VERCEL_OIDC_TOKEN=

# Fallback when OIDC isn't available (CI runners, local without `vercel env pull`).
# Get it from https://vercel.com/<team>/<project>/settings → AI Gateway.
# AI_GATEWAY_API_KEY=

# Override the model used by the chat agent. Default: openai/gpt-4o-mini.
# Use the `provider/model` AI Gateway format.
# AI_MODEL="openai/gpt-4o-mini"

# Legacy: only used as fallbacks for AI_MODEL. Direct OpenAI fetch (no gateway)
# is still used by /lib/ai/text-to-speech.ts and /lib/ai/transcribe.ts because
# the gateway doesn't expose the speech / Whisper endpoints yet.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Optional: Whisper model for Telegram voice notes (default whisper-1)
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# Optional: vision model used to OCR / describe Telegram photos.
# AI_VISION_MODEL="gpt-4o-mini"

### TTS (in-app voice replies) ###
# OpenAI TTS for the optional voice replies the bot can send back.
# Requires BLOB_READ_WRITE_TOKEN to upload the audio to Vercel Blob.
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# OPENAI_TTS_VOICE="nova"
# OPENAI_TTS_INSTRUCTIONS=""

# Canonical origin for sitemap.xml / robots.txt / OpenGraph / JSON-LD and
# absolute links inside emails. Production (Vercel): https://will.trefolio.com
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

### SEO / Search Console verification (optional) ###
# Paste the verification token (just the value of the `content` attribute,
# not the full <meta> tag) from each console. Both are emitted from the
# root <head> via `metadata.verification` in src/app/layout.tsx.
# Google: https://search.google.com/search-console → property → Settings → Ownership verification → HTML tag.
# GOOGLE_SITE_VERIFICATION=""
# Bing:   https://www.bing.com/webmasters → Settings → Verify ownership → Meta tag.
# BING_SITE_VERIFICATION=""

### Telegram (Bot API) ###
# Telegram is Will's primary conversational channel.
# Create a bot with @BotFather; upload `public/will-icon-512.png` via
# /setuserpic and `/setdescription` "Will, your note-taking AI.".
#
# `TELEGRAM_BOT_USERNAME` is the handle without the leading @ (e.g. "WillNoteBot").
# `TELEGRAM_WEBHOOK_SECRET` is sent back as `X-Telegram-Bot-Api-Secret-Token`
# on every inbound update; the webhook handler rejects requests without it.
# `TELEGRAM_LINK_TOKEN_SECRET` signs the deep-link tokens minted by
# `/api/settings/telegram` (HMAC-SHA256). Falls back to NEXTAUTH_SECRET when
# unset, but production should use a dedicated key.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# TELEGRAM_LINK_TOKEN_SECRET=""

# Used by `npm run telegram:webhook` to register the webhook with Telegram.
# Must be the public URL Vercel serves the route at.
# TELEGRAM_WEBHOOK_URL="https://will.trefolio.com/api/webhooks/telegram"

### Cloudflare Turnstile (captcha for /register and /contact, optional) ###
# Without these, signup and contact still work — the verifier degrades to a
# no-op when no secret key is set. Configure in production to keep bots out.
# Get the keys from https://dash.cloudflare.com/?to=/:account/turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
# Hard-disable Turnstile (both client widget and server check) in any
# environment by setting this to "1". Useful for staging or smoke tests.
# TURNSTILE_DISABLED=""
# NEXT_PUBLIC_TURNSTILE_DISABLED=""

### Email verification (Resend, recommended) ###
# When set, the email/password sign-up flow sends a signed verification link
# (JWT, expires in 24h) and refuses to issue a session until the link is
# clicked. When unset, sign-up still works but the verification email is
# logged instead of sent — fine for `next dev`, NOT recommended in
# production.
#
# Env-var names are intentionally identical to trefolio's and Clara's so the
# same Vercel project configuration (Resend account, sender domain, signing
# secret) can be reused without renaming anything:
#
#   - RESEND_API_KEY        — same Resend secret as trefolio / Clara.
#   - RESEND_FROM_ADDRESS   — sender; default points at will.trefolio.com,
#                             override per environment if you self-host.
#   - APP_BASE_URL          — public origin used to build absolute links in
#                             the verification email. Preferred over
#                             NEXT_PUBLIC_APP_URL / NEXTAUTH_URL, which are
#                             still honoured as fallbacks.
#   - APP_SESSION_SECRET    — JWT signing secret for the verification token.
#                             Preferred over NEXTAUTH_SECRET, which is also
#                             honoured for backwards compat.
# RESEND_API_KEY=""
# RESEND_FROM_ADDRESS="Will <noreply@will.trefolio.com>"
# APP_BASE_URL="http://localhost:3000"
# APP_SESSION_SECRET="replace-with-a-long-random-string"

# Optional: best-effort admin ping when a new user signs up (email/password
# or Google). Leave unset to skip the notification; signup still works
# (verification mail to the user is independent of this).
# SIGNUP_NOTIFY_EMAIL=""

### Vercel Blob (optional, enables TTS voice replies) ###
# Without this, the TTS pipeline becomes a silent no-op (text replies only).
# Generated automatically when you add a Blob store to the Vercel project.
# BLOB_READ_WRITE_TOKEN=""

### Cron (Vercel) ###
# Vercel sends `Authorization: Bearer <CRON_SECRET>` on every scheduled call.
# In dev (no CRON_SECRET) the routes accept the call so localhost manual
# tests still work. REQUIRED in production.
# CRON_SECRET=""

### Rate limiting (Upstash Redis, optional) ###
# Without these, rate limiters fail open (no limiting) — fine for local dev.
# Get them from https://console.upstash.com/ → Redis → Rest API.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

### Observability (optional) ###
# When set, error-level logs are forwarded to Sentry via dynamic import of
# `@sentry/nextjs` (the package is *not* a hard dep — install it yourself if
# you want this).
# SENTRY_DSN=""

### trefolio Identity Provider (unified accounts) ###
# Will delegates authentication to the trefolio IdP at user.trefolio.com.
#
#   IDP_BASE_URL    — Override only for local dev. Code defaults to
#                     `https://user.trefolio.com` when NODE_ENV=production
#                     and this is unset, so production deploys "just work".
#                     For local dev, set to `http://localhost:3300`.
#                     With HTTPS proxy hosts (`*.trefolio-dev.com`), keep this
#                     loopback for Node and set NEXTAUTH_URL to your dev host;
#                     configure external/accounts with IDP_ISSUER (+ optional
#                     IDP_SERVER_ORIGIN) — see dev/README.md in stocktracker.
#                     On Vercel **production**, leave unset or set explicitly to
#                     https://user.trefolio.com — never localhost (code overrides
#                     loopback to user.trefolio.com if misconfigured).
#   IDP_CLIENT_ID   — Stable client identifier registered with the IdP.
#                     Always `will` for this app.
#   IDP_CLIENT_SECRET     — Server-only OAuth secret. Required.
#   IDP_SERVICE_TOKEN     — Bearer token Will presents to the IdP's
#                           /v1/* admin and entitlements endpoints.
#   USE_LEGACY_AUTH=false — Routes the /login page through the IdP instead
#                           of NextAuth's local credentials provider.
# IDP_BASE_URL=http://localhost:3300
# IDP_CLIENT_ID=will
# IDP_CLIENT_SECRET=
# IDP_SERVICE_TOKEN=
# USE_LEGACY_AUTH=false
