################################################################
# Will (notetaker) — environment variables
# Copy to .env.local and fill in. Lines marked REQUIRED will cause
# the app to crash or fail silently at startup if missing.
################################################################

############# 1) CORE — REQUIRED #################################

# Postgres 14+. Pooled URL recommended on Vercel + Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/will?schema=public"

# Public URL of the app (NextAuth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Long random string. Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Canonical public origin used for emails, sitemaps, OG images, llms.txt.
APP_BASE_URL="http://localhost:3000"

############# 2) AI — REQUIRED for the agent ######################

# Mode A — Vercel AI Gateway (recommended in production).
# After `vercel link`, run `vercel env pull .env.local` to populate
# VERCEL_OIDC_TOKEN automatically. CI / non-Vercel hosts can use the
# fallback key:
# AI_GATEWAY_API_KEY="ag_..."

# Mode B — direct OpenAI (always required: Whisper + TTS hit OpenAI directly).
OPENAI_API_KEY="sk-..."

# Optional override (default: openai/gpt-4o-mini via AI Gateway when set).
# AI_MODEL="openai/gpt-4o"

############# 3) Telegram — OPTIONAL (enables Telegram channel) ###

# Without these the webhook returns 503 and the web app still works.
# 1. Create a bot with @BotFather, copy the token.
# 2. Set the variables below.
# 3. Deploy, then run: npm run telegram:webhook

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""           # without the @
TELEGRAM_WEBHOOK_SECRET=""         # any random string; verifies inbound calls

# Used by `npm run telegram:webhook` to register the webhook URL.
TELEGRAM_WEBHOOK_URL=""

# Signs the deep-link codes emitted by /api/settings/telegram.
# Falls back to NEXTAUTH_SECRET when unset — fine for dev.
TELEGRAM_LINK_TOKEN_SECRET=""

############# 4) Google sign-in — OPTIONAL ########################

# Without these, email/password and passkey sign-in still work.
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

############# 5) Email (Resend) — OPTIONAL but recommended ########

# Without these the verification email is only logged to the console.
# Required in production.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Will <noreply@will.trefolio.com>"

# JWT secret for the email-verification token (falls back to NEXTAUTH_SECRET).
APP_SESSION_SECRET=""

############# 6) Rate limiting (Upstash Redis) — OPTIONAL #########

# Without these, rate limiters fail open. Production should set them.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

############# 7) Vercel Blob — OPTIONAL (enables TTS replies) #####

BLOB_READ_WRITE_TOKEN=""
# OPENAI_TTS_MODEL="gpt-4o-mini-tts"
# OPENAI_TTS_VOICE="nova"

############# 8) Cloudflare Turnstile — OPTIONAL ###################

NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Set both to "1" to hard-disable captcha (e.g. staging).
# TURNSTILE_DISABLED="1"
# NEXT_PUBLIC_TURNSTILE_DISABLED="1"

############# 9) Cron auth — REQUIRED on Vercel ###################

# Vercel cron requests carry an Authorization: Bearer <CRON_SECRET> header.
# Generate any random string and add to Vercel project env. Locally, just
# leave blank and call /api/cron/* manually for testing.
CRON_SECRET=""

############# 10) SEO verification — OPTIONAL #####################

GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

############# 11) Sentry — OPTIONAL ##############################

# Install @sentry/nextjs separately if you want error forwarding.
SENTRY_DSN=""
